@echo off
title منصة الباشمهندس - التشغيل والمشاركة الخارجية
echo ===================================================
echo [1/2] جاري تشغيل سيرفر المنصة الداخلي (Vite) على منفذ 5173...
echo ===================================================
start cmd /k "npx vite --port 5173"

echo.
echo انتظر 5 ثواني لضمان بدء السيرفر...
timeout /t 5 /nobreak >nul

echo.
echo ===================================================
echo [2/2] جاري ربط السيرفر بنفق خارجي (localtunnel)...
echo ===================================================
echo.
echo سيظهر لك الآن الرابط العام (Public URL) الذي يمكنك إرساله للطلاب في أي مكان.
echo.
echo ملاحظة: عند فتح الرابط لأول مرة، قد يطلب المتصفح إدخال عنوان الـ IP الخارجي الخاص بجهازك للتحقق.
echo يمكنك معرفة الـ IP الخارجي بالدخول على: https://ipv4.icanhazip.com
echo.
npx localtunnel --port 5173
pause
